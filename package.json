{
  "name": "custom-file-order",
  "displayName": "Custom File Order",
  "description": "Custom file and folder ordering in explorer",
  "version": "1.2.0",
  "publisher": "RARI",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ariubilig/custom-file-order"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "file",
    "folder",
    "order",
    "sort",
    "explorer",
    "organization"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "license": "MIT",
  "main": "./out/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "customFileOrder",
          "name": "Custom File Order",
          "when": "workspaceFolderCount > 0",
          "canMoveViews": true,
          "canSelectMany": true,
          "icon": "images/icon.png"
        }
      ]
    },
    "commands": [
      {
        "command": "customFileOrder.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "customFileOrder.openFile",
        "title": "Open File"
      },
      {
        "command": "customFileOrder.revealInExplorer",
        "title": "Reveal in File Explorer"
      },
      {
        "command": "customFileOrder.moveUp",
        "title": "Move Up",
        "icon": "$(arrow-up)"
      },
      {
        "command": "customFileOrder.moveDown",
        "title": "Move Down",
        "icon": "$(arrow-down)"
      },
      {
        "command": "customFileOrder.resetOrder",
        "title": "Reset to Default Order"
      },
      {
        "command": "customFileOrder.restoreItem",
        "title": "Restore Item Position"
      },
      {
        "command": "customFileOrder.newFile",
        "title": "New File",
        "icon": "$(new-file)"
      },
      {
        "command": "customFileOrder.newFolder",
        "title": "New Folder",
        "icon": "$(new-folder)"
      },
      {
        "command": "customFileOrder.openToSide",
        "title": "Open to the Side"
      },
      {
        "command": "customFileOrder.openInTerminal",
        "title": "Open in Integrated Terminal"
      },
      {
        "command": "customFileOrder.copyRelativePath",
        "title": "Copy Relative Path"
      },
      {
        "command": "customFileOrder.rename",
        "title": "Rename"
      },
      {
        "command": "customFileOrder.delete",
        "title": "Delete"
      },
      {
        "command": "customFileOrder.duplicate",
        "title": "Duplicate"
      },
      {
        "command": "customFileOrder.copy",
        "title": "Copy"
      },
      {
        "command": "customFileOrder.cut",
        "title": "Cut"
      },
      {
        "command": "customFileOrder.paste",
        "title": "Paste"
      },
      {
        "command": "customFileOrder.copyPath",
        "title": "Copy Path"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "customFileOrder.newFile",
          "when": "view == customFileOrder",
          "group": "navigation@1"
        },
        {
          "command": "customFileOrder.newFolder",
          "when": "view == customFileOrder",
          "group": "navigation@2"
        },
        {
          "command": "customFileOrder.refresh",
          "when": "view == customFileOrder",
          "group": "navigation@3"
        },
        {
          "command": "customFileOrder.openInTerminal",
          "when": "view == customFileOrder",
          "group": "1_workspace@1"
        },
        {
          "command": "customFileOrder.paste",
          "when": "view == customFileOrder && customFileOrder.hasClipboard",
          "group": "1_workspace@2"
        }
      ],
      "view/item/context": [
        {
          "command": "customFileOrder.newFile",
          "when": "view == customFileOrder",
          "group": "1_new@1"
        },
        {
          "command": "customFileOrder.newFolder",
          "when": "view == customFileOrder",
          "group": "1_new@2"
        },
        {
          "command": "customFileOrder.openToSide",
          "when": "view == customFileOrder && viewItem == file",
          "group": "2_open@1"
        },
        {
          "command": "customFileOrder.revealInExplorer",
          "when": "view == customFileOrder",
          "group": "2_open@2"
        },
        {
          "command": "customFileOrder.openInTerminal",
          "when": "view == customFileOrder",
          "group": "2_open@3"
        },
        {
          "command": "customFileOrder.moveUp",
          "when": "view == customFileOrder",
          "group": "3_reorder@1"
        },
        {
          "command": "customFileOrder.moveDown",
          "when": "view == customFileOrder",
          "group": "3_reorder@2"
        },
        {
          "command": "customFileOrder.restoreItem",
          "when": "view == customFileOrder",
          "group": "3_reorder@3"
        },
        {
          "command": "customFileOrder.resetOrder",
          "when": "view == customFileOrder",
          "group": "3_reorder@4"
        },
        {
          "command": "customFileOrder.cut",
          "when": "view == customFileOrder",
          "group": "4_clip@1"
        },
        {
          "command": "customFileOrder.copy",
          "when": "view == customFileOrder",
          "group": "4_clip@2"
        },
        {
          "command": "customFileOrder.paste",
          "when": "view == customFileOrder && customFileOrder.hasClipboard",
          "group": "4_clip@3"
        },
        {
          "command": "customFileOrder.copyPath",
          "when": "view == customFileOrder",
          "group": "5_path@1"
        },
        {
          "command": "customFileOrder.copyRelativePath",
          "when": "view == customFileOrder",
          "group": "5_path@2"
        },
        {
          "command": "customFileOrder.rename",
          "when": "view == customFileOrder",
          "group": "6_modify@1"
        },
        {
          "command": "customFileOrder.duplicate",
          "when": "view == customFileOrder",
          "group": "6_modify@2"
        },
        {
          "command": "customFileOrder.delete",
          "when": "view == customFileOrder",
          "group": "6_modify@3"
        }
      ],
      "commandPalette": [
        {
          "command": "customFileOrder.refresh",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "customFileOrder.openFile",
          "when": "false"
        },
        {
          "command": "customFileOrder.revealInExplorer",
          "when": "false"
        },
        {
          "command": "customFileOrder.moveUp",
          "when": "false"
        },
        {
          "command": "customFileOrder.moveDown",
          "when": "false"
        },
        {
          "command": "customFileOrder.resetOrder",
          "when": "false"
        },
        {
          "command": "customFileOrder.restoreItem",
          "when": "false"
        },
        {
          "command": "customFileOrder.rename",
          "when": "false"
        },
        {
          "command": "customFileOrder.delete",
          "when": "false"
        },
        {
          "command": "customFileOrder.duplicate",
          "when": "false"
        },
        {
          "command": "customFileOrder.copy",
          "when": "false"
        },
        {
          "command": "customFileOrder.cut",
          "when": "false"
        },
        {
          "command": "customFileOrder.paste",
          "when": "false"
        },
        {
          "command": "customFileOrder.copyPath",
          "when": "false"
        },
        {
          "command": "customFileOrder.copyRelativePath",
          "when": "false"
        },
        {
          "command": "customFileOrder.openToSide",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Custom File Order",
      "properties": {
        "customFileOrder.rules": {
          "type": "object",
          "default": {},
          "description": "Custom ordering rules for files and folders",
          "markdownDescription": "Define custom ordering rules for specific folders. Each key is a folder path relative to the workspace root, using `/` separators, or `.` for the root itself. Entries may be exact names or globs such as `*.css`. Example:\n```json\n{\n  \".\": {\n    \"order\": [\"package.json\", \"README.md\", \"src\"]\n  },\n  \"src/components\": {\n    \"order\": [\"index.ts\", \"*.tsx\", \"*.css\"]\n  }\n}\n```"
        },
        "customFileOrder.enableAutoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Automatically refresh the tree when files change"
        },
        "customFileOrder.showCustomOrderIndicator": {
          "type": "boolean",
          "default": true,
          "description": "Show visual indicator for folders with custom ordering"
        },
        "customFileOrder.defaultFoldersFirst": {
          "type": "boolean",
          "default": true,
          "description": "Show folders before files when no custom order is set"
        }
      }
    },
    "keybindings": [
      {
        "command": "customFileOrder.rename",
        "key": "f2",
        "when": "focusedView == customFileOrder"
      },
      {
        "command": "customFileOrder.delete",
        "key": "delete",
        "when": "focusedView == customFileOrder"
      },
      {
        "command": "customFileOrder.copy",
        "key": "ctrl+c",
        "when": "focusedView == customFileOrder"
      },
      {
        "command": "customFileOrder.cut",
        "key": "ctrl+x",
        "when": "focusedView == customFileOrder"
      },
      {
        "command": "customFileOrder.paste",
        "key": "ctrl+v",
        "when": "focusedView == customFileOrder"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "16.x",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.2.0",
    "eslint": "^8.28.0",
    "typescript": "^4.9.4"
  },
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "badges": [
    {
      "url": "https://img.shields.io/badge/VS%20Code-Extension-blue",
      "href": "https://marketplace.visualstudio.com/items?itemName=your-publisher-name.custom-file-order",
      "description": "VS Code Extension"
    }
  ]
}
